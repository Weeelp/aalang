(setq head 0)
(setq tail 0)
(setq qbuf "q                               ")
(ei)

(setq eof 0)
(setq bad 0)
(setq fl 0)
(setq fc 0)
(setq fch 0)
(setq np 0)
(setq k 0)
(setq e 0)
(setq ii 0)
(setq sp_left 0)
(setq sp_width 0)
(setq fmt "f                                       ")
(setq ints "i                                                                   ")
(interrupt
  (storeb (+ qbuf tail) (in 0))
  (setq tail (% (+ tail 1) 32)))

(defun getc ()
  (if eof
      0
      (progn
        (while (== head tail))
        (setq gc_v (loadb (+ qbuf head)))
        (setq head (% (+ head 1) 32))
        (if (== gc_v 0) (setq eof 1))
        gc_v)))

(defun digit-p (dp_c)
  (if (>= dp_c 48) (<= dp_c 57) 0))

(defun spec-end (se_p)
  (setq se_j (+ se_p 1))
  (setq sp_left 0)
  (setq sp_width 0)
  (if (== (loadb (+ fmt se_j)) 45)
      (progn (setq sp_left 1) (setq se_j (+ se_j 1))))
  (while (digit-p (loadb (+ fmt se_j)))
    (setq sp_width (+ (* sp_width 10) (- (loadb (+ fmt se_j)) 48)))
    (setq se_j (+ se_j 1)))
  (if (== (loadb (+ fmt se_j)) 100) (+ se_j 1) 0))

(defun read-int ()
  (setq ri_c (getc))
  (setq ri_neg 0)
  (setq ri_v 0)
  (setq ri_n 0)
  (if (== ri_c 45)
      (progn (setq ri_neg 1) (setq ri_c (getc)))
      (if (== ri_c 43) (setq ri_c (getc))))
  (while (digit-p ri_c)
    (setq ri_d (- ri_c 48))
    (if (> ri_v 214748364)
        (setq bad 1)
        (if (== ri_v 214748364)
            (if (> ri_d (+ 7 ri_neg)) (setq bad 1))))
    (setq ri_v (+ (* ri_v 10) ri_d))
    (setq ri_n (+ ri_n 1))
    (setq ri_c (getc)))
  (if (== ri_n 0) (setq bad 1))
  (if (> ri_c 10) (setq bad 1))
  (if ri_neg (- 0 ri_v) ri_v))

(defun pd (pd_n)
  (if (< pd_n -9) (pd (/ pd_n 10)))
  (out 1 (- 48 (% pd_n 10))))

(defun ilen (il_n)
  (setq il_l 1)
  (if (< il_n 0) (setq il_l 2))
  (if (< il_n 0) (setq il_m il_n) (setq il_m (- 0 il_n)))
  (while (< il_m -9)
    (setq il_m (/ il_m 10))
    (setq il_l (+ il_l 1)))
  il_l)

(defun spaces (pad_k)
  (while (> pad_k 0)
    (out 1 32)
    (setq pad_k (- pad_k 1))))

(defun put-int (pi_n)
  (setq pi_pad (- sp_width (ilen pi_n)))
  (if (> pi_pad 0)
      (if (== sp_left 0) (spaces pi_pad)))
  (if (< pi_n 0)
      (progn (out 1 45) (pd pi_n))
      (pd (- 0 pi_n)))
  (if (> pi_pad 0)
      (if (== sp_left 1) (spaces pi_pad)))
  0)

(ei)

(setq fc (getc))
(while (> fc 10)
  (if (< fl 32)
      (progn (storeb (+ fmt fl) fc) (setq fl (+ fl 1)))
      (setq bad 1))
  (setq fc (getc)))
(storeb (+ fmt fl) 0)

(setq k 0)
(while (< k fl)
  (if (== (loadb (+ fmt k)) 37)
      (progn
        (setq e (spec-end k))
        (if e
            (progn (setq np (+ np 1)) (setq k e))
            (setq k (+ k 1))))
      (setq k (+ k 1))))
(if (> np 16) (setq bad 1))

(setq ii 0)
(if (== bad 0)
    (while (< ii np)
      (store (+ ints (* ii 4)) (read-int))
      (setq ii (+ ii 1))))

(if (== bad 0)
    (progn
      (setq k 0)
      (setq ii 0)
      (while (< k fl)
        (setq fch (loadb (+ fmt k)))
        (if (== fch 37)
            (progn
              (setq e (spec-end k))
              (if e
                  (progn
                    (put-int (load (+ ints (* ii 4))))
                    (setq ii (+ ii 1))
                    (setq k e))
                  (progn (out 1 37) (setq k (+ k 1)))))
            (progn (out 1 fch) (setq k (+ k 1))))))
    (progn (out 1 45) (out 1 49)))
