(setq head 0)
(setq tail 0)
(setq eof 0)
(setq qbuf "q                               ")

(interrupt
  (storeb (+ qbuf tail) (in 0))
  (setq tail (% (+ tail 1) 32)))

(defun getc ()
  (if eof
      0
      (progn
        (while (== head tail))
        (setq ch (loadb (+ qbuf head)))
        (setq head (% (+ head 1) 32))
        (if (== ch 0) (setq eof 1))
        ch)))

(ei)

(setq bad 0)
(setq fl 0)
(setq np 0)
(setq k 0)
(setq i 0)
(setq e 0)
(setq x 0)
(setq sl 0)
(setq sw 0)
(setq fmt "f                                       ")
(setq ints "i                                                                   ")

(defun digit-p (c)
  (if (>= c 48) (<= c 57) 0))

(defun spec-end (p)
  (setq j (+ p 1))
  (setq sl 0)
  (setq sw 0)
  (if (== (loadb (+ fmt j)) 45)
      (progn (setq sl 1) (setq j (+ j 1))))
  (while (digit-p (loadb (+ fmt j)))
    (setq sw (+ (* sw 10) (- (loadb (+ fmt j)) 48)))
    (setq j (+ j 1)))
  (if (== (loadb (+ fmt j)) 100) (+ j 1) 0))

(defun read-int ()
  (setq c (getc))
  (setq neg 0)
  (setq v 0)
  (setq nd 0)
  (if (== c 45)
      (progn (setq neg 1) (setq c (getc)))
      (if (== c 43) (setq c (getc))))
  (while (digit-p c)
    (setq d (- c 48))
    (if (> v 214748364)
        (setq bad 1)
        (if (== v 214748364)
            (if (> d (+ 7 neg)) (setq bad 1))))
    (setq v (+ (* v 10) d))
    (setq nd (+ nd 1))
    (setq c (getc)))
  (if (== nd 0) (setq bad 1))
  (if (> c 10) (setq bad 1))
  (if neg (- 0 v) v))

(defun pd (n)
  (if (< n -9) (pd (/ n 10)))
  (out 1 (- 48 (% n 10))))

(defun ilen (n)
  (setq l 1)
  (if (< n 0) (setq l 2))
  (if (< n 0) (setq m n) (setq m (- 0 n)))
  (while (< m -9)
    (setq m (/ m 10))
    (setq l (+ l 1)))
  l)

(defun spaces (cnt)
  (while (> cnt 0)
    (out 1 32)
    (setq cnt (- cnt 1))))

(defun put-int (n)
  (setq pad (- sw (ilen n)))
  (if (> pad 0) (if (== sl 0) (spaces pad)))
  (if (< n 0)
      (progn (out 1 45) (pd n))
      (pd (- 0 n)))
  (if (> pad 0) (if (== sl 1) (spaces pad)))
  0)

(setq x (getc))
(while (> x 10)
  (if (< fl 32)
      (progn (storeb (+ fmt fl) x) (setq fl (+ fl 1)))
      (setq bad 1))
  (setq x (getc)))
(storeb (+ fmt fl) 0)

(while (< k fl)
  (if (== (loadb (+ fmt k)) 37)
      (progn
        (setq e (spec-end k))
        (if e
            (progn (setq np (+ np 1)) (setq k e))
            (setq k (+ k 1))))
      (setq k (+ k 1))))
(if (> np 16) (setq bad 1))

(while (< i np)
  (if (== bad 0) (store (+ ints (* i 4)) (read-int)))
  (setq i (+ i 1)))

(if (== bad 0)
    (progn
      (setq k 0)
      (setq i 0)
      (while (< k fl)
        (setq x (loadb (+ fmt k)))
        (if (== x 37)
            (progn
              (setq e (spec-end k))
              (if e
                  (progn
                    (put-int (load (+ ints (* i 4))))
                    (setq i (+ i 1))
                    (setq k e))
                  (progn (out 1 37) (setq k (+ k 1)))))
            (progn (out 1 x) (setq k (+ k 1))))))
    (print "-1"))
