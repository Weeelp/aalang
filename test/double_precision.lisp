(setq rlo 0)
(setq rhi 0)

(defun hex4 (d)
  (if (< d 10)
      (out 1 (+ 48 d))
      (out 1 (+ 55 d))))

(defun hex16 (w)
  (hex4 (/ w 4096))
  (hex4 (% (/ w 256) 16))
  (hex4 (% (/ w 16) 16))
  (hex4 (% w 16)))

(defun hex32 (w)
  (setq lo (% w 65536))
  (if (< lo 0) (setq lo (+ lo 65536)))
  (setq hi (/ (- w lo) 65536))
  (if (< hi 0) (setq hi (+ hi 65536)))
  (hex16 hi)
  (hex16 lo))

(defun add64 (alo ahi blo bhi)
  (setq carry 0)
  (setq rlo (+ alo blo))
  (if (< alo 0)
      (if (< blo 0)
          (setq carry 1)
          (if (>= rlo 0) (setq carry 1)))
      (if (< blo 0)
          (if (>= rlo 0) (setq carry 1))))
  (setq rhi (+ (+ ahi bhi) carry)))

(defun show64 (alo ahi blo bhi)
  (add64 alo ahi blo bhi)
  (hex32 ahi) (hex32 alo)
  (print " + ")
  (hex32 bhi) (hex32 blo)
  (print " = ")
  (hex32 rhi) (hex32 rlo)
  (print 10))

(show64 -1 1 1 0)
(show64 -1 -1 1 0)
(show64 -1 0 -1 0)
(show64 -1 2147483647 1 0)
